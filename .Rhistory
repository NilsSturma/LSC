library(sna)
cat("cores:", parallel::detectCores(), "\n")
set.seed(555)
nNodes <- 15; nLat <- 5
observedNodes <- seq(nNodes - nLat)
latentNodes <- (nNodes - nLat + 1):nNodes
rAcyclicDirectedAdjMatrix <- function(n, p) {
1 * (upper.tri(matrix(0, n, n)) & matrix(sample(c(TRUE, FALSE), n^2, replace = TRUE,
prob = c(p, 1 - p)), ncol = n))
}
t0 <- Sys.time()
for (i in 1:10) {
L <- rAcyclicDirectedAdjMatrix(nNodes, 0.3)
P <- rperm(rep(0, nNodes))
L <- L[P, P]
g <- LatentDigraph(L, observedNodes, latentNodes)
gCan <- canonicalization(g)
r1 <- checkID(g, subsetSizeControl = 1)
rc1 <- checkID(gCan, subsetSizeControl = 1)
r2 <- checkID(g, subsetSizeControl = 2)
rc2 <- checkID(gCan, subsetSizeControl = 2)
r3 <- checkID(g, subsetSizeControl = 3)
rc3 <- checkID(gCan, subsetSizeControl = 3)
}
t1 <- Sys.time()
cat("time for 10 graphs (all 6 checkID calls):", as.numeric(difftime(t1, t0, units="secs")), "sec\n")
for (p in c(0.15, 0.45)) {
t0 <- Sys.time()
for (i in 1:10) {
L <- rAcyclicDirectedAdjMatrix(nNodes, p)
P <- rperm(rep(0, nNodes))
L <- L[P, P]
g <- LatentDigraph(L, observedNodes, latentNodes)
gCan <- canonicalization(g)
r1 <- checkID(g, subsetSizeControl = 1)
rc1 <- checkID(gCan, subsetSizeControl = 1)
r2 <- checkID(g, subsetSizeControl = 2)
rc2 <- checkID(gCan, subsetSizeControl = 2)
r3 <- checkID(g, subsetSizeControl = 3)
rc3 <- checkID(gCan, subsetSizeControl = 3)
}
t1 <- Sys.time()
cat("p =", p, " time for 10 graphs:", as.numeric(difftime(t1, t0, units="secs")), "sec\n")
}
